# Copier ce fichier en .env puis renseigner les valeurs.
# Le fichier .env n'est JAMAIS versionné (voir .gitignore) : il contient des secrets.

APP_ENV=dev                 # dev | prod (en prod : erreurs masquées, cookies "secure")
APP_URL=http://localhost:8000

# Base relationnelle (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vite_gourmand
DB_USER=vg_app
DB_PASS=change-moi

# Base NoSQL (MongoDB Atlas) - statistiques administrateur
MONGO_URI=mongodb+srv://user:motdepasse@cluster0.xxxxx.mongodb.net/
MONGO_DB=vite_gourmand

# Envoi des mails (SMTP). Si MAIL_HOST est vide en dev, les mails sont écrits dans storage/logs/mails.log
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=contact@vite-gourmand.fr
MAIL_FROM_NAME="Vite & Gourmand"
MAIL_COMPANY=contact@vite-gourmand.fr   # destinataire des messages de la page Contact

# Géocodage (calcul des km de livraison). En dev sans Internet, forcer une distance fictive :
GEOCODER_FAKE_KM=
